# 둘 중 하나만 넣어도 됩니다. 넣은 쪽 모델만 목록에 뜹니다.

# BytePlus ModelArk (Seedream)
# console.byteplus.com → ModelArk → API Keys
ARK_API_KEY=

# 가입한 리전에 맞춰 고릅니다. 비우면 ap-southeast 를 씁니다.
# ap-southeast-1: https://ark.ap-southeast.bytepluses.com/api/v3
# eu-west-1:      https://ark.eu-west.bytepluses.com/api/v3
ARK_BASE_URL=

# Google Gemini (Nano Banana)
# aistudio.google.com/apikey
GEMINI_API_KEY=
